      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. GET DATA: Combine ALL fields to ensure we don't miss the link\n// We merge body_text + html_body + snippet into one string\nconst emailFields = item.json.email_fields || {};\nconst textToSearch = [\n    emailFields.body_text, \n    emailFields.html_body, \n    item.json.snippet, \n    item.json.text\n].join(\" \"); // Join them with a space\n\n// 2. EXTRACT: Regex looks for http:// or https://\nconst urlRegex = /(https?:\\/\\/[^\\s\"<>]+)/g; \n// Added \" and < > to the exclusion list to handle HTML tags cleaner\n\nconst match = textToSearch.match(urlRegex);\n\nif (!match) {\n  // Debugging: This helps you see exactly what text was searched\n  return { \n      json: { \n          hasUrl: false, \n          error: \"No URL found\",\n          debug_searchedText: textToSearch.substring(0, 100) + \"...\" \n      } \n  };\n}\n\n// 3. CLEAN & ENCODE\n// HTML often leaves trailing quotes or tags attached to the URL.\n// We clean them off.\nlet extractedUrl = match[0].replace(/['\"<>\\])]+$/, \"\");\n\n// 4. VirusTotal ID Generation\nconst urlId = Buffer.from(extractedUrl).toString('base64').replace(/=/g, '');\n\nreturn {\n  json: {\n    analyzedUrl: extractedUrl,\n    vtId: urlId,\n    hasUrl: true\n  }\n};"
      },
